{
  "name": "cloudflare-devtools",
  "displayName": "Cloudflare DevTools",
  "description": "Manage Cloudflare's Development Mode and Cache from VS Code.",
  "version": "1.1.1",
  "publisher": "AlessandroBenassi",
  "repository": {
    "type": "git",
    "url": "https://github.com/solid-pixel/vscode-cloudflareDevTools.git"
  },
  "bugs": {
    "url": "https://github.com/solid-pixel/vscode-cloudflareDevTools/issues/new"
  },
  "galleryBanner": {
    "color": "#172031",
    "theme": "dark"
  },
  "icon": "assets/logo.png",
  "badges": [
    {
      "url": "https://badgen.net/vs-marketplace/v/AlessandroBenassi.cloudflare-devtools",
      "href": "https://marketplace.visualstudio.com/items?itemName=AlessandroBenassi.cloudflare-devtools",
      "description": "Latest version"
    }
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "engines": {
    "vscode": "^1.66.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cloudflare",
    "development",
    "development mode",
    "cache",
    "api"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cloudflareDevTools.devOn",
        "title": "Development Mode | ON",
        "category": "Cloudflare DevTools"
      },
      {
        "command": "cloudflareDevTools.devOff",
        "title": "Development Mode | OFF",
        "category": "Cloudflare DevTools"
      },
      {
        "command": "cloudflareDevTools.purgeCache",
        "title": "Purge Cache",
        "category": "Cloudflare DevTools"
      },
      {
        "command": "cloudflareDevTools.commands",
        "title": "Cloudflare DevTools Commands"
      },
      {
        "command": "cloudflareDevTools.configureToken",
        "title": "Set API Token",
        "category": "Cloudflare DevTools"
      },
      {
        "command": "cloudflareDevTools.removeToken",
        "title": "Remove API Token",
        "category": "Cloudflare DevTools"
      },
      {
        "command": "cloudflareDevTools.testConnection",
        "title": "Test Connection",
        "category": "Cloudflare DevTools"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cloudflareDevTools.commands",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cloudflareDevTools-view",
          "title": "Cloudflare DevTools",
          "icon": "assets/cloud.svg"
        }
      ]
    },
    "views": {
      "cloudflareDevTools-view": [
        {
          "id": "cloudflareDevTools-tree",
          "name": "Commands"
        }
      ]
    },
    "configuration": [
      {
        "title": "Cloudflare DevTools",
        "type": "object",
        "id": "cloudflareDevTools",
        "properties": {
          "cloudflareDevTools.api.key": {
            "type": "string",
            "markdownDescription": "Legacy Global API Key. Prefer **Cloudflare DevTools: Set API Token** to store a scoped token securely. A stored API token takes precedence.",
            "order": 1
          },
          "cloudflareDevTools.api.email": {
            "type": "string",
            "description": "Account email for legacy Global API Key authentication. Not needed with an API token.",
            "order": 2
          },
          "cloudflareDevTools.api.zoneID": {
            "type": "string",
            "description": "Zone ID from the Overview of your domain in Cloudflare. This zone is shown in the status bar tooltip.",
            "order": 3,
            "default": "",
            "pattern": "^$|^[a-fA-F0-9]{32}$",
            "patternErrorMessage": "Enter the 32-character hexadecimal Zone ID from your Cloudflare domain overview."
          },
          "cloudflareDevTools.cache.purgeAutomatically": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Purge this zone\u2019s cache three seconds after turning Development Mode **on**. Changing connection settings or turning Development Mode off cancels a pending purge.",
            "order": 4
          },
          "cloudflareDevTools.developmentModeStatus.enable": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Periodically check Development Mode and update the status bar. Connection failures appear in the status bar and Output log.",
            "order": 5
          },
          "cloudflareDevTools.developmentModeStatus.interval": {
            "type": "integer",
            "minimum": 5,
            "default": 60,
            "markdownDescription": "Seconds between completed status checks. After connection errors, checks slow down automatically. Requires `#cloudflareDevTools.developmentModeStatus.enable#`.",
            "order": 6,
            "maximum": 86400
          }
        }
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node --test test/*.test.js",
    "test:integration": "node test/runTest.js",
    "package": "node scripts/package.js",
    "verify:package": "node scripts/verifyPackage.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.9.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "@azure/msal-node": "^7.1.2"
    }
  }
}
